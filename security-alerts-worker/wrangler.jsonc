{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyber-care-security-alerts",
  "main": "src/index.js",
  "compatibility_date": "2026-10-09",
  "vars": {
    "ACCESS_TEAM_DOMAIN": "flat-cell-290e.cloudflareaccess.com",
    "ACCESS_AUD": "d71b64150c77f94e5fe6812c9ed2c7cd465ccb4c4d53429c922d35182fa72d1c",
    "REVIEW_ACTIONS_ENABLED": "true",
    "BUFFER_DRAFTS_ENABLED": "true",
    "BUFFER_ALLOWED_ACCOUNT": "spitz7905"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
